{
    "name": "sticky-table-headers",
    "version": "1.0.0",
    "description": "Keeps table headers visible while you scroll through long tables, with support for multiple tables and horizontal scrolling.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "node esbuild.config.mjs production",
        "typecheck": "tsc --noEmit",
        "test": "node test.js"
    },
    "keywords": [
        "obsidian",
        "obsidian-plugin"
    ],
    "author": "Yinno",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^16.11.6",
        "esbuild": "0.17.3",
        "obsidian": "latest",
        "playwright-core": "^1.63.0",
        "typescript": "4.7.4"
    }
}
